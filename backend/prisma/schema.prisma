generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
  EMPLOYEE
}

enum UserStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum DocumentAction {
  SUMMARIZE
  TRANSLATE
  SUMMARIZE_TRANSLATE
}

enum DocumentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum ValidationAction {
  APPROVE
  REJECT
  IMPROVEMENT
}

enum ReportStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String
  role         Role       @default(USER)
  office       String     @default("Public")
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  preferences         UserPreferences?
  organizationProfile OrganizationProfile?
  documents           Document[]
  validations         ValidationRecord[]
  activityLogs        ActivityLog[]
  reports             Report[]

  @@map("users")
}

model UserPreferences {
  id                    String  @id @default(cuid())
  userId                String  @unique
  interfaceLanguage     String  @default("en")
  defaultSourceLanguage String  @default("Kinyarwanda")
  defaultTargetLanguage String  @default("English")
  defaultSummaryLength  String  @default("medium")
  emailNotifications    Boolean @default(true)
  processingAlerts      Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model OrganizationProfile {
  id               String  @id @default(cuid())
  userId           String  @unique
  organizationName String  @default("")
  department       String  @default("")
  province         String  @default("")
  district         String  @default("")
  sector           String  @default("")
  contactEmail     String  @default("")
  contactPhone     String  @default("")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("organization_profiles")
}

model Document {
  id             String         @id @default(cuid())
  referenceId    String         @unique
  fileName       String
  originalName   String
  fileSize       Int
  mimeType       String
  sourceLanguage String
  targetLanguage String
  action         DocumentAction
  status         DocumentStatus @default(PENDING)
  qualityScore   Float?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  processingResult ProcessingResult?
  validations      ValidationRecord[]

  @@map("documents")
}

model ProcessingResult {
  id          String   @id @default(cuid())
  documentId  String   @unique
  summary     String?
  translation String?
  generatedAt DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("processing_results")
}

model ValidationRecord {
  id         String           @id @default(cuid())
  documentId String
  userId     String
  action     ValidationAction
  feedback   String?
  notes      String?
  createdAt  DateTime         @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("validation_records")
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  details   String?
  metadata  Json?
  ipAddress String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("activity_logs")
}

model SystemSettings {
  id                      String  @id @default(cuid())
  organizationName        String  @default("MINALOC")
  defaultSourceLanguage   String  @default("Kinyarwanda")
  defaultTargetLanguage   String  @default("English")
  maxFileSize             Int     @default(10)
  allowedFileTypes        String  @default("pdf,docx,txt")
  minPasswordLength       Int     @default(8)
  requireSpecialChar      Boolean @default(true)
  sessionTimeout          Int     @default(30)
  enableEmailNotification Boolean @default(true)
  enableProcessingAlerts  Boolean @default(true)
  maintenanceMode         Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

model Report {
  id         String       @id @default(cuid())
  reportName String
  period     String
  type       String       @default("general")
  status     ReportStatus @default(DRAFT)
  content    Json?
  createdBy  String
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  user User @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@map("reports")
}
