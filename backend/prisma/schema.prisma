generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
  EMPLOYEE
}

enum UserStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum SourceType {
  FILE
  TEXT
}

enum ProcessingOption {
  SUMMARIZE
  TRANSLATE
  SUMMARIZE_TRANSLATE
}

enum DocumentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum ValidationOption {
  APPROVE
  REJECT
  IMPROVEMENT
}

enum ReportStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String
  role         Role       @default(USER)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  preferences  UserPreferences?
  documents    Document[]
  validations  Validation[]
  activityLogs ActivityLog[]
  reports      Report[]

  @@map("users")
}

model UserPreferences {
  id                    String  @id @default(cuid())
  userId                String  @unique
  interfaceLanguage     String  @default("en")
  defaultSourceLanguage String  @default("Kinyarwanda")
  defaultTargetLanguage String  @default("English")
  defaultSummaryLength  String  @default("medium")
  inAppNotifications    Boolean @default(true)
  processingAlerts      Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model Document {
  id               String           @id @default(cuid())
  documentName     String
  originalName     String
  fileSize         Int
  mimeType         String
  sourceType       SourceType       @default(FILE)
  sourceLanguage   String
  targetLanguage   String
  processingOption ProcessingOption
  status           DocumentStatus   @default(PENDING)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  // AI Output Fields (Merged from ProcessingResult)
  summary     String?
  translation String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  validations Validation[]

  @@map("documents")
}

model Validation {
  id               String           @id @default(cuid())
  documentId       String
  userId           String
  validationOption ValidationOption
  feedback         String?
  notes            String?
  createdAt        DateTime         @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("validations")
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  details   String?
  metadata  Json?
  ipAddress String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("activity_logs")
}

model SystemSettings {
  id String @id @default(cuid())

  // Organization Details (Global)
  organizationName String @default("MINALOC")
  province         String @default("")
  contactEmail     String @default("")

  // Global Defaults & Configurations
  defaultSourceLanguage   String  @default("Kinyarwanda")
  defaultTargetLanguage   String  @default("English")
  maxFileSize             Int     @default(10)
  allowedFileTypes        String  @default("pdf,docx,txt")
  minPasswordLength       Int     @default(8)
  requireSpecialChar      Boolean @default(true)
  sessionTimeout          Int     @default(30)
  enableInAppNotification Boolean @default(true)
  enableProcessingAlerts  Boolean @default(true)
  maintenanceMode         Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

model Report {
  id         String       @id @default(cuid())
  reportName String
  period     String
  status     ReportStatus @default(DRAFT)
  filePath   String
  createdBy  String
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  user User @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@map("reports")
}
